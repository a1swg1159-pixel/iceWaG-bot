ENVIRONMENT=production
HOST=0.0.0.0
PORT=8081
ONEBOT_V11_ACCESS_TOKEN=CHANGE_ME
BOT_QQ=CHANGE_ME
DAILY_PUSH_GROUPS=
WEATHER_CITY=北京
ADMIN_QQ=你的QQ号

# LXNS OAuth 应用（勾选“无回调地址”，申请 read_user_profile、read_player、write_player）
LXNS_OAUTH_CLIENT_ID=9a6be364-2c97-4773-89ec-8c7d04fcbd41
LXNS_OAUTH_CLIENT_SECRET=

# 可选：服务器直连舞萌机台服务失败时使用的 HTTP 代理
MAIMAI_ARCADE_HTTP_PROXY=

# 可选：独立掉线邮件监控（使用 docker-compose.alerts.yml 启动）
# 与 /email 收件通知完全独立；不要复用或公开用户绑定文件里的授权码。
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SMTP_SECURITY=ssl
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_INSTANCE_NAME=iceWaG-bot
# 秒：每 30 秒检查，异常持续 120 秒报警，恢复持续 60 秒通知。
ALERT_CHECK_INTERVAL=30
ALERT_OFFLINE_SECONDS=120
ALERT_RECOVERY_SECONDS=60
ALERT_STARTUP_GRACE=120
ALERT_RETRY_SECONDS=300
